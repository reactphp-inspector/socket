parameters:
	level: max
	paths:
		- ../../etc
		- ../../src
		- ../../tests
	excludePaths:
		- ../../src/ContextAwareConnection.php
	ignoreErrors:
		-
			identifier: ergebnis.noParameterWithNullableTypeDeclaration
			path: ../../src/SocketInstrumentation.php
		-
			identifier: shipmonk.deadConstant
			path: ../../src/SocketInstrumentation.php

